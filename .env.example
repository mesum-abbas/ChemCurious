# Copy to .env.local for local development, and add the same keys in
# Vercel → Project → Settings → Environment Variables for deployments.
# Never commit real values.

# ---- Database (MySQL / TiDB) — required ----
# On Vercel this must be a hosted database reachable from the internet (not localhost).
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password_here
DB_NAME=chemistry_playground
# Set to "true" for hosted databases that require TLS (e.g. TiDB Cloud)
DB_SSL=false
# Keep small on serverless (each function instance opens its own pool)
DB_POOL_MAX=5

# ---- Auth — required ----
# At least 32 random characters, or production builds/requests fail.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Public site URL, used in password-reset links (e.g. https://your-app.vercel.app)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---- ChemBot AI tutor (server-only — never prefix with NEXT_PUBLIC_) ----
GEMINI_API_KEY=
GROQ_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GROQ_MODEL=openai/gpt-oss-20b
CHAT_TIMEOUT_MS=15000
